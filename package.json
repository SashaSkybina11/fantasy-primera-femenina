{
  "name": "fantasy-primera-division-futbol-sala-femenino",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "typecheck": "tsc -p backend/tsconfig.scripts.json && tsc -b frontend",
    "lint": "eslint backend/src frontend/src api && node tests/localization-source.mjs",
    "test:consistency": "node --import tsx backend/tests/consistency.integration.ts",
    "test:localization": "node tests/localization-source.mjs && node tests/localization.mjs",
    "test:refresh": "node tests/recalculation-refresh.mjs",
    "dev": "concurrently --kill-others-on-fail -n backend,frontend -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "db:generate": "npm run prisma:generate -w backend",
    "db:migrate": "npm run prisma:migrate -w backend",
    "db:seed": "npm run prisma:seed -w backend",
    "db:clear-users": "npm run clear-users -w backend",
    "db:reset-users": "npm run reset-users -w backend",
    "vercel-build": "npm run prisma:migrate:deploy -w backend && npm run prisma:generate -w backend && npm run build",
    "db:reset-game": "npm run reset-game -w backend --",
    "db:audit-prices": "npm run audit-prices -w backend --",
    "db:restore-game": "npm run restore-game -w backend --",
    "db:check-csv": "tsx backend/scripts/sync-csv-prices.ts",
    "db:sync-csv": "tsx backend/scripts/sync-csv-prices.ts --write",
    "test:prelaunch": "node --import tsx --test backend/tests/prelaunch.integration.ts",
    "test:prelaunch-ui": "node --import tsx tests/prelaunch-ui.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "playwright": "^1.51.1",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  }
}
